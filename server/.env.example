# Copy to .env and fill in. .env is git-ignored; never commit real values.

NODE_ENV=development
PORT=8000
# Interface to listen on. Leave as 127.0.0.1 unless the server must be reachable from other machines.
HOST=127.0.0.1

# Required for every POST (sync) request, sent as an x-api-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Comma-separated browser origins allowed to call the API (defaults to the Vite dev server)
CORS_ORIGINS=http://localhost:5173

FPL_API_URL=https://fantasy.premierleague.com/api

MONGO_URI=
MONGO_URI_TEST=

MY_FPL_MANAGER_ID=
